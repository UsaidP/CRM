{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "sentry-cli@claude-plugins-official": true,
    "cloudinary@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "modern-web-guidance@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(bun run lint)",
      "Bash(bun run test:*)",
      "Bash(bun test:*)",
      "Bash(bunx tsc --noEmit)",
      "Bash(bunx prisma generate)",
      "Bash(bunx prisma migrate status)",
      "Bash(bunx prisma validate)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(which:*)",
      "Bash(node --version)",
      "Bash(bun --version)",
      "Bash(pwd)"
    ],
    "ask": [
      "Edit(src/lib/db/tenant-guard.ts)",
      "Edit(src/lib/db/tenant-context.ts)",
      "Edit(src/lib/domain/rbac-engine.ts)",
      "Edit(src/lib/domain/commission-calculator.ts)",
      "Edit(src/lib/services/api-auth.ts)",
      "Edit(src/lib/services/server-auth.ts)",
      "Edit(src/lib/money.ts)",
      "Edit(prisma/schema.prisma)",
      "Write(src/lib/db/tenant-guard.ts)",
      "Write(src/lib/db/tenant-context.ts)",
      "Write(src/lib/domain/rbac-engine.ts)",
      "Write(src/lib/domain/commission-calculator.ts)",
      "Write(src/lib/services/api-auth.ts)",
      "Write(src/lib/services/server-auth.ts)",
      "Write(src/lib/money.ts)",
      "Write(prisma/schema.prisma)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
