{
  "name": "zamzam-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint src/",
    "db:push": "bunx prisma db push",
    "db:seed": "bun prisma/seed.js",
    "db:clean": "bun scripts/clean-db.js",
    "db:fresh": "bun scripts/reset-to-superadmin.js",
    "db:fresh:remote": "node scripts/reset-production.js",
    "test": "bun test/run-all-tests.js",
    "test:unit": "bun test test/unit/ test/crm.test.js test/money-format.test.ts test/toast.test.ts",
    "test:api": "bun test test/api/",
    "test:security": "bun test test/security/",
    "test:performance": "bun test test/performance/",
    "test:overnight": "bun test test/overnight/",
    "test:coverage": "bun test --coverage test/unit/ test/crm.test.js test/money-format.test.ts test/toast.test.ts test/api-auth-coverage.test.ts test/tenant-context.test.ts test/session-route.test.ts",
    "test:ci": "bun test test/unit/ test/crm.test.js test/money-format.test.ts test/toast.test.ts test/api-auth-coverage.test.ts test/tenant-context.test.ts test/session-route.test.ts test/security/ test/api/ test/overnight/",
    "backup": "bun scripts/backup.ts",
    "restore": "bun scripts/restore.ts",
    "open:brave": "open -a 'Brave Browser' http://localhost:3000"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@prisma/client": "^6.4.1",
    "@sentry/nextjs": "^10.73.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "agentation": "^3.0.2",
    "agentation-mcp": "^1.2.0",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "goey-toast": "^0.5.0",
    "lucide-react": "^1.16.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "15.1.7",
    "postcss": "^8.5.2",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
