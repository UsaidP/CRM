# ==============================================================================
# ZAMZAM CRM - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to .env or add these keys to your hosting provider (e.g. Vercel)
# ==============================================================================

# Application Base URL (e.g. https://your-crm.vercel.app)
NEXT_PUBLIC_APP_URL="https://your-crm-domain.vercel.app"

# Firm contact details printed on generated letterheads, CSV exports and WhatsApp
# quotations. The tenant NAME and MahaRERA number come from the organization
# record in the database (Organization.name / Organization.reraBrokerRegistration),
# not from env — these two are the only pieces not modelled on Organization.
# Leave blank to omit them from generated documents.
NEXT_PUBLIC_FIRM_PHONE=""
NEXT_PUBLIC_FIRM_WEBSITE=""

# Database Connection (Supabase PostgreSQL with IPv4 Pooler)
# DATABASE_URL: Transaction Pooler on port 6543 (used by Prisma queries at runtime)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&connect_timeout=20&pool_timeout=20&schema=public"

# DIRECT_URL: Session Pooler on port 5432 (used by Prisma migrations and schema pushes)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connect_timeout=20&schema=public"

# QA_DATABASE_URL: Structural read-only connection used by overnight QA agents (qa_agent_ro role)
QA_DATABASE_URL="postgresql://qa_agent_ro:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&connect_timeout=20&pool_timeout=20&schema=public"

# Authentication & Security
# Generate with: openssl rand -hex 32
JWT_SECRET="your-32-byte-hex-jwt-secret"
SUPER_ADMIN_KEY="your-64-character-hex-super-admin-master-key"
SUPER_ADMIN_EMAIL="admin@zamzamproperties.in"

# Google Gemini AI (for brochure extraction and AI parsing)
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_API_KEY="your-google-api-key"

# Cloudinary (for high-speed property media & brochure CDN storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_URL="cloudinary://[API_KEY]:[API_SECRET]@[CLOUD_NAME]"

# Google Drive Integration (optional automated backups & webhooks)
GOOGLE_DRIVE_FOLDER_URL="https://drive.google.com/drive/folders/..."
GOOGLE_DRIVE_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"

# Sentry Performance & Error Telemetry (Optional)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="zamzam-crm"
SENTRY_PROJECT="crm-web"

# Context7 MCP (live library docs for agents — referenced via ${CONTEXT7_API_KEY} in .mcp.json)
# NOTE: a literal key was previously committed to .agents/mcp_config.json. Rotate it:
#   https://context7.com/dashboard  ->  revoke old key, issue new one
CONTEXT7_API_KEY="ctx7sk-your-context7-api-key"

# Phone OTP Authentication & SMS Provider
# Options: 'mock' (default in dev, logs to terminal), 'msg91' (India), or 'twilio' (global)
OTP_PROVIDER="mock"

# If using MSG91:
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_TEMPLATE_ID="your-msg91-dlt-template-id"
MSG91_SENDER_ID="ZAMZAM"

# If using Twilio:
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Daily WhatsApp Cron Secret
CRON_SECRET="your-cron-secret-for-scheduled-digests"

