# ==============================================================================
# ZAMZAM CRM - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to .env or add these keys to your hosting provider (e.g. Vercel)
# ==============================================================================

# Application Base URL (e.g. https://zamzam-crm.vercel.app or https://crm.zamzamproperties.in)
NEXT_PUBLIC_APP_URL="https://your-crm-domain.vercel.app"

# Database Connection (Supabase PostgreSQL with IPv4 Pooler)
# DATABASE_URL: Transaction Pooler on port 6543 (used by Prisma queries at runtime)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&connect_timeout=20&pool_timeout=20&schema=public"

# DIRECT_URL: Session Pooler on port 5432 (used by Prisma migrations and schema pushes)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connect_timeout=20&schema=public"

# Authentication & Security
# Generate with: openssl rand -hex 32
JWT_SECRET="your-32-byte-hex-jwt-secret"
SUPER_ADMIN_KEY="your-64-character-hex-super-admin-master-key"
SUPER_ADMIN_EMAIL="admin@zamzamproperties.in"

# Google Gemini AI (for brochure extraction and AI parsing)
GEMINI_API_KEY="your-gemini-api-key"
GOOGLE_API_KEY="your-google-api-key"

# Cloudinary (for high-speed property media & brochure CDN storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_URL="cloudinary://[API_KEY]:[API_SECRET]@[CLOUD_NAME]"

# Google Drive Integration (optional automated backups & webhooks)
GOOGLE_DRIVE_FOLDER_URL="https://drive.google.com/drive/folders/..."
GOOGLE_DRIVE_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"
